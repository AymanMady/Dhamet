# Copy to .env (never commit it). Every variable is optional in development.

# HTTP and WebSocket port.
PORT=3000

# JWT signing secret: required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in seconds (default 30 days).
JWT_EXPIRES_IN_SECONDS=2592000

# PostgreSQL: either DATABASE_URL, or the DB_* variables.
# docker-compose.yml publishes its database on localhost:5436.
# DATABASE_URL=postgres://dhamet:dhamet@localhost:5436/dhamet
DB_HOST=localhost
DB_PORT=5436
DB_USER=dhamet
DB_PASSWORD=dhamet
DB_NAME=dhamet
# The schema is created by the migrations at startup (default true).
DB_MIGRATIONS_RUN=true
# Development only: sync the schema with the entities (default false).
DB_SYNCHRONIZE=false

# Seconds a disconnected player has to come back before forfeiting.
RECONNECT_GRACE_SECONDS=60

# Allowed CORS origins, comma-separated, or * for any.
CORS_ORIGINS=*

# Rate limit of /api/auth/*: requests per window and client.
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_SECONDS=60

# Reverse proxies to trust when reading the client address (Express
# `trust proxy`): false, true, a number of hops, or addresses/subnets.
# Render: 3 (Cloudflare, load balancer, internal proxy). Default false.
TRUST_PROXY=false

# docker compose only: host ports.
DB_HOST_PORT=5436
API_PORT=3000
