{
  "name": "dhamet-server",
  "version": "0.1.0",
  "description": "Authoritative multiplayer server for Dhamet (NestJS + WebSocket), rules from the Dart engine compiled to JavaScript",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:engine": "cd engine_bridge && dart pub get && dart run tool/build.dart ../src/engine/generated/dhamet_engine.js",
    "prebuild": "npm run build:engine",
    "build": "nest build",
    "start": "node dist/main",
    "prestart:dev": "npm run build:engine",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "pretest": "npm run build:engine",
    "test": "jest",
    "pretest:e2e": "npm run build:engine",
    "test:e2e": "jest --config test/jest-e2e.json",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:generate": "typeorm migration:generate -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "sql.js": "^1.14.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
